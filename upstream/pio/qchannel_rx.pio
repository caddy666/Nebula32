; =============================================================================
; qchannel_rx.pio
; CXD2500BQ Q-channel subcode capture (80 bits = 10 bytes)
;
; Hardware: Q-channel serial output from CXD2500BQ
; Pins:
;   pin+0  = QCL  (clock OUTPUT driven by us)
;   pin+1  = QDA  (data  INPUT  from CXD2500)
;
; Protocol (from original firmware):
;   The CXD2500 drives QDA.  We generate QCL.
;   For each bit: QCL=0, QCL=1, sample QDA (LSB first).
;   10 bytes × 8 bits = 80 clocks total.
;   DMA moves the 10 bytes from the RX FIFO automatically.
;
; Trigger: SCOR falling edge causes CPU to enable this SM.
;          (Or SM waits for QDA==1 as a start condition.)
;
; Flow:
;   1. Wait for QDA to go high (start condition after SCOR)
;   2. Capture 80 bits, pushing 8-bit words to RX FIFO (autopush)
;   3. SM disables itself by irq, signalling CPU that capture is done
;
; FIFO: RX only, autopush at 8 bits
; =============================================================================

.program qchannel_rx
.side_set 1               ; side-set drives QCL (pin+0)

    ; Wait for QDA (pin+1) to be asserted (high = data valid start)
    wait 1 pin 1        side 0    ; block until QDA=1 (pin+1 high)

    ; Capture 10 bytes (80 bits), LSB first
    set y, 9            side 0    ; outer loop: 10 bytes

byte_loop:
    set x, 7            side 0    ; inner loop: 8 bits

bit_loop:
    nop                 side 0    ; QCL=0 (setup)
    in pins, 1          side 1    ; QCL=1, sample QDA into ISR
    jmp x-- bit_loop    side 0    ; QCL=0, next bit

    push noblock        side 0    ; push completed byte to RX FIFO
    jmp y-- byte_loop   side 0    ; next byte

    ; Signal CPU that capture is complete
    irq set 0           side 0    ; raise IRQ 0 (SM-relative)

    ; Reset and wait for next SCOR (SM will be restarted by IRQ handler)

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/irq.h"

/**
 * @brief Initialise the Q-channel RX state machine.
 *
 * @param pio        PIO instance
 * @param sm         State machine index
 * @param offset     Program offset
 * @param pin_qcl    GPIO for QCL (clock out); QDA = pin_qcl + 1
 * @param freq_hz    QCL bit clock in Hz (e.g. 300000 for 300 kHz)
 */
static inline void qchannel_rx_program_init(PIO pio, uint sm, uint offset,
                                             uint pin_qcl, uint freq_hz)
{
    pio_gpio_init(pio, pin_qcl);        /* QCL output */
    pio_gpio_init(pio, pin_qcl + 1);    /* QDA input  */

    pio_sm_set_consecutive_pindirs(pio, sm, pin_qcl,     1, true);  /* QCL out */
    pio_sm_set_consecutive_pindirs(pio, sm, pin_qcl + 1, 1, false); /* QDA in  */
    gpio_pull_up(pin_qcl + 1);

    pio_sm_config c = qchannel_rx_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin_qcl);
    sm_config_set_in_pins(&c, pin_qcl);           /* in pins base = QCL; QDA = offset+1 */
    sm_config_set_in_shift(&c, true, true, 8);    /* shift right (LSB first), autopush 8 */

    float div = (float)clock_get_hz(clk_sys) / (float)(freq_hz * 2);
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);
    /* SM started on-demand when SCOR fires — not enabled here */
}

/**
 * @brief Start a Q-channel capture.  Returns immediately; completion
 *        is signalled by PIO IRQ 0.
 */
static inline void qchannel_start_capture(PIO pio, uint sm)
{
    pio_sm_clear_fifos(pio, sm);
    pio_sm_restart(pio, sm);
    pio_sm_set_enabled(pio, sm, true);
}

/**
 * @brief Drain 10 bytes from the RX FIFO into buf[10].
 *        Call after the PIO IRQ fires.
 */
static inline void qchannel_drain(PIO pio, uint sm, uint8_t *buf)
{
    pio_sm_set_enabled(pio, sm, false);
    for (int i = 0; i < 10; i++) {
        uint32_t w = pio_sm_get_blocking(pio, sm);
        buf[i] = (uint8_t)(w & 0xFFu);
    }
}
%}
