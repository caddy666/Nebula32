; =============================================================================
; dsic2.pio
; DSIC2 servo IC bidirectional serial interface
;
; Hardware: Sony CXA1372 / DSIC2 focus+radial+sledge servo controller
; Pins (consecutive, base = PIN_DSIC_CLK):
;   pin+0  = SICL  (clock, always output)
;   pin+1  = SIDA  (data, bidirectional — direction controlled by CPU)
;   pin+2  = SILD  (latch strobe, always output)
;
; Two state machines share the same pin base:
;   SM0 — dsic2_tx  : shift 8 bits MSB-first, then pulse SILD
;   SM1 — dsic2_rx  : clock in 8 bits MSB-first (SIDA as input)
;
; Only one SM runs at a time.  The driver enables/disables them before
; switching direction on SIDA.
;
; TX protocol:
;   For each bit (MSB first): SICL=0, put bit on SIDA, SICL=1
;   After all bits: SIDA=1 (idle), SILD=0 then SILD=1 (latch)
;   ~150 µs settle — handled by the CPU after the SM finishes
;
; RX protocol:
;   SIDA is driven by the DSIC2 IC.
;   For each bit: SICL=0, SICL=1, sample SIDA into ISR (MSB first)
;   After 8 bits: SILD=0 then SILD=1, data available in RX FIFO
; =============================================================================

; ---- TX state machine -------------------------------------------------------

.program dsic2_tx
.side_set 1               ; side-set drives SICL (pin+0)

; TX FIFO: 8-bit word written by CPU, autopulled into OSR
; Shifts left (MSB first)

.wrap_target
    pull ifempty       side 0    ; get byte from FIFO, SICL=0
    set x, 7           side 0    ; 8 bits
tx_loop:
    out pins, 1        side 0    ; SICL=0, put MSB on SIDA (pin+1)
    nop                side 1    ; SICL=1 — DSIC2 samples here
    jmp x-- tx_loop    side 0    ; SICL=0, next bit

    ; Release SIDA=1, then pulse SILD (pin+2)
    set pins, 0b110    side 0    ; SIDA=1, SILD=1 (idle states) — set covers pin+1,pin+2
    set pins, 0b100    side 0    ; SILD=0 (latch falling edge)
    set pins, 0b110    side 0    ; SILD=1 (latch rising edge / complete)
.wrap

; ---- RX state machine -------------------------------------------------------

.program dsic2_rx
.side_set 1               ; side-set drives SICL (pin+0)

; SIDA (pin+1) is configured as INPUT before this SM is enabled.
; Reads 8 bits MSB-first, pushes to RX FIFO when ISR full (autopush).

.wrap_target
    set x, 7           side 0    ; 8 bits to receive
    set pins, 0b000    side 0    ; SILD=0 (pre-latch)
rx_loop:
    nop                side 0    ; SICL=0 — setup time for DSIC2 to drive SIDA
    nop                side 1    ; SICL=1 — data valid
    in pins, 1         side 1    ; sample SIDA (pin+1) into ISR
    jmp x-- rx_loop    side 0    ; SICL=0, next bit

    ; Latch: SILD pulse
    set pins, 0b100    side 0    ; SILD=1
    set pins, 0b000    side 0    ; SILD=0

    push noblock       side 0    ; push 8 bits to RX FIFO
.wrap

% c-sdk {
#include "hardware/clocks.h"

/**
 * @brief Initialise both DSIC2 state machines (TX and RX).
 *
 * @param pio          PIO instance
 * @param sm_tx        SM index for transmit
 * @param sm_rx        SM index for receive
 * @param offset_tx    Program offset for dsic2_tx
 * @param offset_rx    Program offset for dsic2_rx
 * @param pin_clk      GPIO for SICL (SIDA=pin+1, SILD=pin+2)
 * @param freq_hz      Bit clock in Hz (e.g. 200000 for 200 kHz)
 */
static inline void dsic2_program_init(PIO pio,
                                       uint sm_tx, uint sm_rx,
                                       uint offset_tx, uint offset_rx,
                                       uint pin_clk, uint freq_hz)
{
    /* Claim pins */
    pio_gpio_init(pio, pin_clk);        /* SICL */
    pio_gpio_init(pio, pin_clk + 1);    /* SIDA */
    pio_gpio_init(pio, pin_clk + 2);    /* SILD */

    /* SICL and SILD are always outputs; SIDA starts as output (TX mode) */
    pio_sm_set_consecutive_pindirs(pio, sm_tx, pin_clk,     1, true);  /* SICL */
    pio_sm_set_consecutive_pindirs(pio, sm_tx, pin_clk + 1, 1, true);  /* SIDA out */
    pio_sm_set_consecutive_pindirs(pio, sm_tx, pin_clk + 2, 1, true);  /* SILD */

    float div = (float)clock_get_hz(clk_sys) / (float)(freq_hz * 2);

    /* ---- TX SM ---- */
    {
        pio_sm_config c = dsic2_tx_program_get_default_config(offset_tx);
        sm_config_set_sideset_pins(&c, pin_clk);
        sm_config_set_out_pins(&c, pin_clk + 1, 1);  /* SIDA */
        sm_config_set_set_pins(&c, pin_clk + 1, 2);  /* SIDA + SILD */
        sm_config_set_out_shift(&c, false, true, 8);  /* shift left (MSB first), autopull 8 */
        sm_config_set_clkdiv(&c, div);
        pio_sm_init(pio, sm_tx, offset_tx, &c);
    }

    /* ---- RX SM ---- */
    {
        pio_sm_config c = dsic2_rx_program_get_default_config(offset_rx);
        sm_config_set_sideset_pins(&c, pin_clk);
        sm_config_set_in_pins(&c, pin_clk + 1);      /* SIDA */
        sm_config_set_set_pins(&c, pin_clk + 2, 1);  /* SILD only */
        sm_config_set_in_shift(&c, false, true, 8);   /* shift left (MSB first), autopush 8 */
        sm_config_set_clkdiv(&c, div);
        pio_sm_init(pio, sm_rx, offset_rx, &c);
    }

    /* Start with TX SM enabled, RX SM disabled */
    pio_sm_set_enabled(pio, sm_tx, true);
    pio_sm_set_enabled(pio, sm_rx, false);
}

/**
 * @brief Write one byte to DSIC2 (MSB first) via PIO TX SM.
 */
static inline void dsic2_pio_write(PIO pio, uint sm_tx, uint8_t data)
{
    pio_sm_put_blocking(pio, sm_tx, (uint32_t)data << 24); /* left-justify for MSB-first */
}

/**
 * @brief Read one byte from DSIC2 via PIO RX SM.
 *        Switches SIDA to input, runs RX SM, then reverts.
 */
static inline uint8_t dsic2_pio_read(PIO pio, uint sm_tx, uint sm_rx, uint pin_sida)
{
    /* Stop TX, switch SIDA to input */
    pio_sm_set_enabled(pio, sm_tx, false);
    pio_gpio_init(pio, pin_sida);
    gpio_set_dir(pin_sida, GPIO_IN);
    gpio_pull_up(pin_sida);
    pio_sm_set_consecutive_pindirs(pio, sm_rx, pin_sida, 1, false);

    /* Run RX SM, wait for one byte */
    pio_sm_clear_fifos(pio, sm_rx);
    pio_sm_set_enabled(pio, sm_rx, true);
    uint32_t raw = pio_sm_get_blocking(pio, sm_rx);
    pio_sm_set_enabled(pio, sm_rx, false);

    /* Revert SIDA to output for TX */
    gpio_set_dir(pin_sida, GPIO_OUT);
    pio_sm_set_consecutive_pindirs(pio, sm_tx, pin_sida, 1, true);
    pio_sm_set_enabled(pio, sm_tx, true);

    return (uint8_t)(raw >> 24);  /* MSB-first: data arrived in bits 31:24 */
}
%}
