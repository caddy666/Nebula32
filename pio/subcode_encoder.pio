; =============================================================================
; subcode_encoder.pio — CD Subcode Q-channel serialiser with clock output
; =============================================================================
;
; Drives four subcode signals to Akiko (connector pins 17/18/14/15 → GPIO 5-8):
;   SUB_DATA  (GPIO 5, OUT)   — serial Q-channel data bits
;   SUB_CLK   (GPIO 6, SIDE)  — bit clock, generated by side-set each cycle
;   SUB_WFCLK (GPIO 7, GPIO)  — word-frame clock (pulsed from _push_subcode())
;   SUB_SCOR  (GPIO 8, GPIO)  — sync correlator  (pulsed from _push_subcode())
;
; SUB_CLK timing:
;   CLK=0 for 16 SM cycles: data is stable and valid (setup time for Akiko)
;   CLK=1 for 16 SM cycles: Akiko samples SUB_DATA on the rising edge
;   Data changes on CLK falling edge.  50 % duty cycle.
;
; SUB_WFCLK and SUB_SCOR are NOT generated by this PIO program.  They are
; driven as plain GPIO outputs by subcode_pulse_sector_clocks() in subcode.h,
; called once per sector from _push_subcode() before the FIFO push.
;
; Subcode bit rate:
;   Firmware uses 176400 bps (75 sectors/s × 98 frames × 24 bits/frame).
;   clkdiv formula: sys_clk / (target_bitrate_hz × 32).
;   At 135.475 MHz and 176400 bps: clkdiv ≈ 24.
;   Each bit: 32 SM cycles × (clkdiv / sys_clk) ≈ 5.67 µs.
;
; PIO resource: PIO0 SM1  (see PIO allocation table in CLAUDE.md)
; =============================================================================

.program subcode_encoder
.side_set 1   ; 1 side-set bit drives SUB_CLK (the pin at subcode_pin + 1)

; Each word from the TX FIFO is 32 bits; pulled MSB-first via 'out pins, 1'.
; side-set value 0 = CLK low, 1 = CLK high.

.wrap_target
    pull block          side 0     ; wait for 32-bit word; CLK idles low
    set x, 31           side 0     ; 32 bits per word
bit_loop:
    out pins, 1         side 0 [15]  ; 16 cycles: data valid, CLK=0 (setup)
    jmp x-- bit_loop    side 1 [15]  ; 16 cycles: CLK=1 (Akiko samples)
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

// Configure subcode encoder SM.
//   subcode_pin       — base GPIO (SUB_DATA = subcode_pin, SUB_CLK = subcode_pin+1)
//                       SUB_WFCLK = subcode_pin+2, SUB_SCOR = subcode_pin+3
//   target_bitrate_hz — typically 176400 for 1x
static inline void subcode_encoder_program_init(PIO pio, uint sm,
                                                 uint offset,
                                                 uint subcode_pin,
                                                 uint32_t target_bitrate_hz) {
    pio_sm_config cfg = subcode_encoder_program_get_default_config(offset);

    // OUT pin: SUB_DATA (subcode_pin)
    sm_config_set_out_pins(&cfg, subcode_pin, 1);
    pio_gpio_init(pio, subcode_pin);
    gpio_set_dir(subcode_pin, GPIO_OUT);
    gpio_put(subcode_pin, 0);

    // SIDE-SET pin: SUB_CLK (subcode_pin + 1)
    sm_config_set_sideset_pins(&cfg, subcode_pin + 1);
    pio_gpio_init(pio, subcode_pin + 1);
    gpio_set_dir(subcode_pin + 1, GPIO_OUT);
    gpio_put(subcode_pin + 1, 0);

    // SUB_WFCLK (subcode_pin + 2) and SUB_SCOR (subcode_pin + 3) are plain
    // GPIO outputs pulsed by subcode_pulse_sector_clocks() once per sector.
    gpio_init(subcode_pin + 2);
    gpio_set_dir(subcode_pin + 2, GPIO_OUT);
    gpio_put(subcode_pin + 2, 0);
    gpio_init(subcode_pin + 3);
    gpio_set_dir(subcode_pin + 3, GPIO_OUT);
    gpio_put(subcode_pin + 3, 0);

    // Clock divider: 32 SM cycles per bit → clkdiv = sys_clk / (rate × 32)
    float sys_clk_hz = (float)clock_get_hz(clk_sys);
    float clkdiv = sys_clk_hz / ((float)target_bitrate_hz * 32.0f);
    sm_config_set_clkdiv(&cfg, clkdiv);

    // OSR: shift left (MSB first), autopull disabled
    sm_config_set_out_shift(&cfg, false, false, 32);

    pio_sm_init(pio, sm, offset, &cfg);
    pio_sm_set_enabled(pio, sm, true);
}
%}
