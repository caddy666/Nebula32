# Build outputs
*.bin
*.elf
*.elf.map
*.uf2
*.hex
*.dis
*.o
*.vscode/

CLAUDE.MD

# CMake build system
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
build/
build-*/

# Build-generated tool/SDK trees (regenerated by cmake at configure/build time;
# not source — the real SDK lives at $PICO_SDK_PATH)
generated/
pioasm/
pioasm-install/
pico-sdk/

# Python virtualenv under tools/ (local environment, never committed)
tools/venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# pioasm-generated PIO headers (regenerated at build time)
*.pio.h
# ...except the hand-written host-test stubs (pioasm can't run in the host build)
!tests/stubs/*.pio.h

# Large logic-analyser capture CSVs (multi-GB, not tracked in git)
tests/cd32_logic_replay_bundle/*.csv

# Reference documentation and schematics (large binaries, not tracked in git)
docs/

# Logic analyser application
*.AppImage

# ctags symbol index (regenerate with: ctags-universal -R --languages=C,C++ src/ include/ pio/)
tags

# TLS certificate files — generated by tools/gen_tls_cert.sh; never committed
# (they contain a private key). The rest of SDCARD_BASE/ (e.g. nebula32.cfg) is
# a tracked copy-to-SD skeleton. Copy SDCARD_BASE/* to the SD card root.
certs/
SDCARD_BASE/certs/
include/tls_cert.h

# Logic-analyser capture files (large binaries, not used by tests)
timings/
